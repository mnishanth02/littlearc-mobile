{
  "name": "@littlearc/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./router": {
      "types": "./src/router.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "start:worker": "tsx --env-file-if-exists=../../.env src/worker.ts",
    "start:all": "tsx --env-file-if-exists=../../.env src/all.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@littlearc/contracts": "workspace:*",
    "@littlearc/db": "workspace:*",
    "@trpc/server": "11.18.0",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "tsx": "4.23.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@littlearc/config": "workspace:*",
    "@trpc/client": "11.18.0",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
